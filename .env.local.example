# Supabase — copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys or real resident data.

# Public: safe to expose to the browser (used by the anon client + RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: full-access service role key. NEVER expose to the browser and
# NEVER prefix with NEXT_PUBLIC_. Only read this from server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The app sends no email and runs no scheduled jobs, so there is nothing to
# configure for either — incident reports, maintenance requests and the RA
# weekly report are all read inside the app.

# Shared temporary password for scripts/seed-ra-accounts.mjs (min 10 chars).
# Handed to RAs in person; every seeded account must replace it on first
# login. Never hardcoded, never committed.
RA_TEMP_PASSWORD=pick-a-shared-temp-password
