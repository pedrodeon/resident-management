# Supabase — copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys or real resident data.

# Public: safe to expose to the browser (used by the anon client + RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: full-access service role key. NEVER expose to the browser and
# NEVER prefix with NEXT_PUBLIC_. Only read this from server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — server-only, used by incident reports and maintenance
# requests. Sending happens in server actions; the key never reaches the
# browser. Both report types go to the RD; replies reach the filer via
# reply-to.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Tudor Hall <reports@your-verified-domain>"
RD_EMAIL=rd@example.edu

# Protects /api/cron/weekly-report (the scheduled RA weekly report). Any long
# random string (e.g. `openssl rand -hex 32`). On Vercel, a CRON_SECRET env
# var is automatically sent as the Bearer token on cron invocations.
CRON_SECRET=generate-a-long-random-string
